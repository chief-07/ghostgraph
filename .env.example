# Google AI Studio Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# FalkorDB Connection (Cloud or Local Docker)
# If using FalkorDB Cloud (https://app.falkordb.cloud):
FALKORDB_HOST=your_cloud_host.falkordb.cloud
FALKORDB_PORT=6379
FALKORDB_PASSWORD=your_falkordb_password

# If using local Docker (docker run -p 6379:6379 falkordb/falkordb):
# FALKORDB_HOST=localhost
# FALKORDB_PORT=6379
# FALKORDB_PASSWORD=

# Server Configuration
PORT=8000
HOST=127.0.0.1
DEBUG=True
